    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "concrete5/core": "^9.5",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "allow-plugins": {
            "mlocati/composer-patcher": true
        }
    }
}
