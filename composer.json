{
    "name": "limegreentangerine/s3_storage",
    "description": "Adds S3 storage options to Concrete CMS",
    "type": "concrete5-package",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "S3Storage\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Lee Jones",
            "email": "prolific.jones82@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
